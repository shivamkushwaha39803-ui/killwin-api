import { Client, Databases, ID, Query } from 'node-appwrite';

const PROJECT_ID = process.env.APPWRITE_FUNCTION_PROJECT_ID || '6ab2b71c00171587d4fc';
const DATABASE_ID = '6ab2bdb4000c76cc3bef';
const FEE = 0.02;

const TABLES = {
  users: '6ab2bf1d0025b9c53f38',
  admins: '6ab34851002ce1959b05',
  config: '6ab348cb001698034464',
  game_rounds: '6ab349bd001c6378143a',
  transactions: 'transactions',
  bets: '6ab34ddf001d569d3f06'
};

const GAME_RULES = {
  wingo: { seconds: 30 },
  tiger: { seconds: 30 },
  number100: { seconds: 300 }
};

function nowMs() { return Date.now(); }
function money(n) { return Math.round(Number(n || 0) * 100) / 100; }

function hashString(s) {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function mulberry32(a) {
  return function () {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function seededInt(period, max) {
  const rand = mulberry32(hashString(String(period)));
  return Math.floor(rand() * max);
}

function seededChoice(period, arr) {
  return arr[seededInt(period, arr.length)];
}

function randomId() {
  return Date.now().toString(36) + Math.random().toString(36).substring(2, 11);
}

function periodInfo(gameId, t = nowMs()) {
  const seconds = GAME_RULES[gameId]?.seconds || 30;
  const size = seconds * 1000;
  const start = Math.floor(t / size) * size;
  const end = start + size;
  const d = new Date(start);
  const period = `${d.getUTCFullYear()}${String(d.getUTCMonth() + 1).padStart(2, '0')}${String(d.getUTCDate()).padStart(2, '0')}${String(d.getUTCHours()).padStart(2, '0')}${String(d.getUTCMinutes()).padStart(2, '0')}${String(d.getUTCSeconds()).padStart(2, '0')}`;
  return { gameId, period, startAtMs: start, endAtMs: end };
}

function colorForNumber(n) {
  if (n === 0 || n === 5) return 'violet';
  return n % 2 === 0 ? 'red' : 'green';
}
function sizeForNumber(n) { return n >= 5 ? 'Big' : 'Small'; }

function generateOutcome(gameId, period) {
  if (gameId === 'wingo') {
    const number = seededInt(period, 10);
    return { number, color: colorForNumber(number), size: sizeForNumber(number) };
  }
  if (gameId === 'tiger') return { winner: seededChoice(period, ['Tiger', 'Lion', 'Tie']) };
  if (gameId === 'number100') return { number: seededInt(period, 101) };
  throw new Error('Unsupported game');
}

function payoutMultiplier(gameId, selection, category) {
  if (gameId === 'wingo') {
    if (category === 'Color') return selection === 'violet' ? 4.5 : 2;
    if (category === 'Size') return 2;
    if (category === 'Number') return 9;
  }
  if (gameId === 'tiger') return selection === 'Tie' ? 8 : 2;
  if (gameId === 'number100') return 30;
  return 0;
}

function isWinningBet(gameId, bet, outcome) {
  if (gameId === 'wingo') {
    if (bet.category === 'Color') return String(bet.selection).toLowerCase() === outcome.color;
    if (bet.category === 'Size') return String(bet.selection).toLowerCase() === outcome.size.toLowerCase();
    if (bet.category === 'Number') return Number(bet.selection) === Number(outcome.number);
  }
  if (gameId === 'tiger') return String(bet.selection).toLowerCase() === String(outcome.winner).toLowerCase();
  if (gameId === 'number100') return Number(bet.selection) === Number(outcome.number);
  return false;
}

function parseResult(value) {
  if (!value) return null;
  if (typeof value === 'object') return value;
  try { const parsed = JSON.parse(String(value)); return parsed && typeof parsed === 'object' ? parsed : null; } catch (_) { return null; }
}

export default async function (context) {
  const client = new Client()
    .setEndpoint('https://cloud.appwrite.io/v1')
    .setProject(PROJECT_ID)
    .setKey(process.env.APPWRITE_FUNCTION_API_KEY);

  const db = new Databases(client);

  const getRow = async (tableId, rowId) => {
    try { return await db.getRow(DATABASE_ID, tableId, rowId); } 
    catch (e) { if (e.code === 404) return null; throw e; }
  };
  
  const createRow = async (tableId, data, rowId = 'unique()') => {
    return await db.createRow(DATABASE_ID, tableId, rowId, data);
  };
  
  const updateRow = async (tableId, rowId, data) => {
    return await db.updateRow(DATABASE_ID, tableId, rowId, data);
  };

  const listRows = async (tableId, queries = []) => {
    return await db.listRows(DATABASE_ID, tableId, queries);
  };

  const uid = context.req.headers['x-appwrite-user-id'];
  const requireUser = () => { if (!uid) throw new Error('Login required.'); return uid; };
  const requireAdmin = async () => {
    const uid = requireUser();
    const direct = await getRow(TABLES.admins, uid);
    if (direct) return uid;
    const list = await listRows(TABLES.admins);
    const ok = list.rows.some(r => String(r.user_id || r.uid) === uid && String(r.role || 'admin').toLowerCase() === 'admin');
    if (!ok) throw new Error('Admin verification failed.');
    return uid;
  };

  const actions = {
    createProfile: async (data) => {
      const uid = requireUser();
      const existing = await getRow(TABLES.users, uid);
      if (existing) return existing;
      return createRow(TABLES.users, {
        uid,
        username: String(data.username || 'Gamer').trim().slice(0, 80),
        phone: String(data.phone || '').trim().slice(0, 40),
        balance: 0, deposit_balance: 0, winning_balance: 0,
        created_at: new Date().toISOString()
      }, uid);
    },

    getProfile: async () => {
      const uid = requireUser();
      const row = await getRow(TABLES.users, uid);
      if (!row) throw new Error('User profile not found.');
      return {
        ...row,
        depositBalance: Number(row.deposit_balance || 0),
        winningBalance: Number(row.winning_balance || 0),
        balance: Number(row.balance || 0)
      };
    },

    getPlatformConfig: async () => {
      const row = await getRow(TABLES.config, 'platform');
      return row ? { upiId: row.upi_id || '', qrImgUrl: row.qr_img_url || '' } : { upiId: '', qrImgUrl: '' };
    },

    setPlatformConfig: async (data) => {
      await requireAdmin();
      const payload = {};
      if (data.upiId !== undefined) payload.upi_id = String(data.upiId || '').trim();
      if (data.qrImgUrl !== undefined) payload.qr_img_url = String(data.qrImgUrl || '').trim();
      return updateRow(TABLES.config, 'platform', payload);
    },

    ensureGameRound: async (data) => {
      const gameId = String(data.game_id || data.gameId || '').trim();
      if (!GAME_RULES[gameId]) throw new Error('Unsupported game_id.');

      const current = periodInfo(gameId);
      const currentId = `${gameId}_${current.period}`;

      let round = await getRow(TABLES.game_rounds, currentId);
      if (!round) {
        const outcome = generateOutcome(gameId, current.period);
        round = await createRow(TABLES.game_rounds, {
          game_id: gameId, period: current.period,
          start_at_ms: current.startAtMs, end_at_ms: current.endAtMs,
          status: 'open', result_json: JSON.stringify(outcome)
        }, currentId);
      }
      return { gameId, period: current.period, startAtMs: current.startAtMs, endAtMs: current.endAtMs, serverNowMs: nowMs() };
    },

    placeGameBet: async (data) => {
      const uid = requireUser();
      const gameId = String(data.game_id || data.gameId || '');
      if (!GAME_RULES[gameId]) throw new Error('Unsupported game_id.');

      const amount = money(data.amount);
      const selection = String(data.selection ?? '').trim();
      const category = String(data.category || '').trim();
      const round = periodInfo(gameId);

      const multiplier = payoutMultiplier(gameId, selection, category);
      const user = await getRow(TABLES.users, uid);
      
      const betId = `bet_${randomId()}`;
      const updatedBalance = money(Number(user.balance) - amount);

      await updateRow(TABLES.users, uid, { balance: updatedBalance });
      const bet = await createRow(TABLES.bets, {
        bet_id: betId, user_id: uid, game_id: gameId, period: round.period,
        selection, category, amount, multiplier, status: 'open', payout: 0,
        created_at: new Date().toISOString()
      }, betId);

      return { betId, period: round.period, balance: updatedBalance, bet };
    },

    getWingoHistory: async () => {
      const list = await listRows(TABLES.game_rounds);
      const history = list.rows
        .filter(x => x.game_id === 'wingo' && x.status === 'settled')
        .sort((a, b) => String(b.period).localeCompare(String(a.period)))
        .slice(0, 50)
        .map(x => {
          const r = parseResult(x.result_json) || {};
          return { period: x.period, number: Number(r.number), color: r.color || '', size: r.size || '' };
        });
      return { history };
    },

    submitDeposit: async (data) => {
      const uid = requireUser();
      const amount = money(data.amount);
      const utr = String(data.utr || '').trim();
      const user = await getRow(TABLES.users, uid);
      const txId = `tx_${randomId()}`;
      return createRow(TABLES.transactions, {
        tx_id: txId, user_id: uid, username: user.username || 'Gamer',
        type: 'Deposit', amount, details: `UTR: ${utr}`,
        status: 'Pending', timestamp: new Date().toISOString()
      }, txId);
    },

    requestWithdrawal: async (data) => {
      const uid = requireUser();
      const amount = money(data.amount);
      const user = await getRow(TABLES.users, uid);
      const newBalance = money(Number(user.balance) - amount);
      await updateRow(TABLES.users, uid, { balance: newBalance });
      const txId = `tx_${randomId()}`;
      return createRow(TABLES.transactions, {
        tx_id: txId, user_id: uid, username: user.username || 'Gamer',
        type: 'Withdraw', amount, details: JSON.stringify(data.details),
        status: 'Pending', timestamp: new Date().toISOString()
      }, txId);
    },

    adminListUsers: async () => {
      await requireAdmin();
      const list = await listRows(TABLES.users);
      return { users: list.rows };
    },

    adminAddMoney: async (data) => {
      await requireAdmin();
      const amount = money(data.amount);
      const q = String(data.userQuery || '').trim();
      let target = await getRow(TABLES.users, q);
      if (!target) {
        const list = await listRows(TABLES.users);
        target = list.rows.find(u => u.phone === q || u.username === q || u.uid === q);
      }
      if (!target) throw new Error('User not found.');
      return updateRow(TABLES.users, target.$id, {
        balance: money(Number(target.balance || 0) + amount),
        deposit_balance: money(Number(target.deposit_balance || 0) + amount)
      });
    },

    adminListTransactions: async () => {
      await requireAdmin();
      const list = await listRows(TABLES.transactions);
      return { transactions: list.rows.sort((a, b) => String(b.timestamp).localeCompare(String(a.timestamp))) };
    },

    approveTransaction: async (data) => {
      await requireAdmin();
      const tx = await getRow(TABLES.transactions, data.txId);
      if (tx.status !== 'Pending') return tx;
      if (tx.type === 'Deposit') {
        const user = await getRow(TABLES.users, tx.user_id);
        await updateRow(TABLES.users, tx.user_id, {
          balance: money(Number(user.balance || 0) + Number(tx.amount)),
          deposit_balance: money(Number(user.deposit_balance || 0) + Number(tx.amount))
        });
      }
      return updateRow(TABLES.transactions, data.txId, { status: 'Approved' });
    },

    verifyAdmin: async () => { await requireAdmin(); return { isAdmin: true }; },

    settleGameRound: async (data) => {
      return { status: 'settled' };
    }
  };

  try {
    const body = context.req.bodyJson || {};
    const action = String(body.action || '');
    const data = body.data || {};

    if (!actions[action]) return context.res.json({ error: `Unknown action: ${action}` }, 400);
    
    const result = await actions[action](data);
    return context.res.json({ data: result });
  } catch (err) {
    context.error(err.message);
    return context.res.json({ error: err.message || 'Server error' }, 400);
  }
}